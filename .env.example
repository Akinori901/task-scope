# Django
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=task_scope
MYSQL_USER=user
MYSQL_PASSWORD=secret
MYSQL_HOST=db
MYSQL_PORT=3306


# AI Evaluation Proxy (ホスト上の Claude Code CLI ラッパー)
EVAL_PROXY_URL=http://host.docker.internal:19001
EVAL_PROXY_PORT=19001
# 任意。設定すると proxy は X-Eval-Proxy-Token の一致を要求し、backend は自動で付ける。
# 127.0.0.1 以外で待ち受ける（EVAL_PROXY_HOST）場合は必須。
# 生成例: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
EVAL_PROXY_TOKEN=
# EVAL_PROXY_HOST=127.0.0.1
# 1 にするとコード探索で Bash（git log 等）を許可する。チケット本文経由の
# プロンプトインジェクションでホスト上のコマンドが実行されうるため既定は無効。
# EVAL_PROXY_ALLOW_BASH=1

# Ports ※ 実装調査のPortと被らないように設定すること
BACKEND_PORT=19000
FRONTEND_PORT=3100
DB_PORT=13307
PHPMYADMIN_PORT=19080
